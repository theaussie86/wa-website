# Gmail API (Service Account)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GMAIL_USER_EMAIL=your-workspace-user@your-domain.com
GMAIL_FROM_ALIAS=kontakt@your-domain.com
CONTACT_RECIPIENT_EMAIL=your-personal-email@gmail.com

# Google Tag Manager
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Google reCAPTCHA v3 (Spamschutz der Formulare)
# Schlüsselpaar unter https://www.google.com/recaptcha/admin anlegen, Typ v3,
# und dort "localhost" als erlaubte Domain eintragen - dann laufen die
# Formulare auch lokal durch.
#
# Googles öffentliche Testschlüssel funktionieren hier nicht: Sie antworten
# zwar mit success:true, aber ohne "score" und ohne "action", und genau die
# beiden Felder prüft src/lib/spam-check.ts. Jede Einsendung würde abgewiesen.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6Lxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RECAPTCHA_SECRET_KEY=6Lxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Brevo
BREVO_API_KEY=dein-api-key-hier

# PocketBase (Freebie-Fortschritt)
# In Produktion der Netz-Alias im dokploy-network: http://pocketbase:8090
# Lokal über den SSH-Tunnel: ssh -N -L 8090:127.0.0.1:8090 cwe-dokploy
POCKETBASE_URL=http://127.0.0.1:8090
# Impersonate-Token des Superusers app@... , erzeugt in der Admin-UI
POCKETBASE_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

GUIDE_JWT_SECRET=min-32-zufaellige-zeichen
